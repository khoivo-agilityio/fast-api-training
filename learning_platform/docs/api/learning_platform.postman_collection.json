{
  "info": {
    "name": "AI-Enhanced Learning Platform",
    "description": "Complete API collection for the Learning Platform. \n\n## Setup\n1. Import this collection\n2. Import the **learning_platform** environment (or create one with `baseUrl = http://localhost:8001`)\n3. Select the **learning_platform** environment in Postman\n4. Run **Register** or **Login** \u2014 tokens are saved automatically to the environment via test scripts\n5. All authenticated requests use `{{accessToken}}` automatically",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },

  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "description": "Check if the app, DB, and Redis are healthy."
          },
          "response": [
            {
              "name": "200 Healthy",
              "status": "OK",
              "code": 200,
              "body": "{\"status\": \"healthy\"}"
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (Student)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  pm.environment.set('accessToken', data.access_token);",
                  "  pm.environment.set('refreshToken', data.refresh_token);",
                  "  console.log('Tokens saved. Role: student');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"display_name\": \"Alice Smith\"\n}"
            },
            "description": "Register a new student account. Tokens are automatically saved to the environment."
          }
        },
        {
          "name": "Register (Instructor)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  pm.environment.set('accessToken', data.access_token);",
                  "  pm.environment.set('refreshToken', data.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"instructor@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"display_name\": \"Bob Instructor\"\n}"
            },
            "description": "NOTE: Role defaults to 'student'. Promote to instructor via Admin > Update User or SQLAdmin UI."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.environment.set('accessToken', data.access_token);",
                  "  pm.environment.set('refreshToken', data.refresh_token);",
                  "  console.log('Login successful. Tokens saved.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "description": "Login and get access + refresh tokens. Tokens auto-saved to variables."
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.environment.set('accessToken', data.access_token);",
                  "  pm.environment.set('refreshToken', data.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "description": "Exchange refresh token for a new token pair."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/logout",
            "description": "Blacklist the current access token. Returns 200."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/users/me",
            "description": "Get the authenticated user's profile."
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/users/me",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"display_name\": \"Alice Updated\"\n}"
            },
            "description": "Partial update: only include fields you want to change. Supports: display_name, avatar, password."
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/users/me",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"NewPassword456!\"\n}"
            }
          }
        },
        {
          "name": "Request Avatar Presigned URL",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  pm.environment.set('avatarObjectKey', data.object_key);",
                  "  pm.environment.set('avatarUploadUrl', data.upload_url);",
                  "  console.log('Presigned URL saved. Expires in', data.expires_in, 'seconds.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/users/me/avatar/presigned",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content_type\": \"image/jpeg\"\n}"
            },
            "description": "Step 1 of avatar upload: get a presigned S3 PUT URL. The object_key and upload_url are auto-saved."
          }
        },
        {
          "name": "Upload Avatar (Binary)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "{{avatarContentType}}"
              }
            ],
            "url": "{{avatarUploadUrl}}",
            "body": {
              "mode": "file",
              "file": {
                "src": ""
              }
            },
            "description": "Step 2: PUT the image file directly to the presigned S3 URL. Select a file in the Body > binary tab. No Bearer token needed (the URL is pre-authenticated)."
          }
        },
        {
          "name": "Confirm Avatar Upload",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/users/me/avatar",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"object_key\": \"{{avatarObjectKey}}\"\n}"
            },
            "description": "Step 3: confirm the upload. Server validates magic bytes and stores the CDN URL on your profile."
          }
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        {
          "name": "List Courses",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/courses?limit=20&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "courses"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "offset",
                  "value": "0"
                },
                {
                  "key": "search",
                  "value": "python",
                  "disabled": true
                },
                {
                  "key": "instructor",
                  "value": "<uuid>",
                  "disabled": true
                }
              ]
            },
            "description": "List all courses. Optional: ?search=python, ?instructor=<uuid>"
          }
        },
        {
          "name": "Create Course",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.environment.set('courseId', pm.response.json().id);",
                  "  console.log('courseId saved:', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/courses",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Introduction to Python\",\n  \"description\": \"A beginner-friendly Python course covering syntax, data structures, and OOP.\"\n}"
            },
            "description": "Requires Instructor or Admin role. courseId auto-saved."
          }
        },
        {
          "name": "Get Course",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/courses/{{courseId}}"
          }
        },
        {
          "name": "Update Course",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/courses/{{courseId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Introduction to Python (Updated)\",\n  \"description\": \"Updated description.\"\n}"
            }
          }
        },
        {
          "name": "Enroll in Course",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/courses/{{courseId}}/enroll",
            "description": "Student enrolls in a course. Requires Student role."

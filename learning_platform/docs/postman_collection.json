      "name": "0 — Health Check",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "http://localhost:8001/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('healthy', () => pm.expect(pm.response.json().status).to.eql('healthy'));"
                ]
              }
            }
          ]
        }
      ]
    },

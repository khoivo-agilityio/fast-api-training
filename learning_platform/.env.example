# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=Learning Platform API
ENABLE_DEBUG=false

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/learning_platform

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Quiz ─────────────────────────────────────────────────────────────────────
QUIZ_PASS_THRESHOLD=70

# ── SQLAdmin ─────────────────────────────────────────────────────────────────
SQLADMIN_SECRET_KEY=change-me-sqladmin-secret

# ── Storage backend selector ──────────────────────────────────────────────────
# Use "local" for MinIO (dev) or "s3" for AWS S3 (production).
STORAGE_BACKEND=local

# ── MinIO (local dev — only read when STORAGE_BACKEND=local) ─────────────────
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_PUBLIC_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=learning-platform
MINIO_REGION=us-east-1

# ── AWS S3 (production — only read when STORAGE_BACKEND=s3) ──────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "5.4 Cleanup — Admin deletes course",
          "item": [
            {
              "name": "DELETE /admin/courses/{id} — Admin deletes course",
              "request": {
                "method": "DELETE",
                "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }],
                "url": "{{base_url}}/admin/courses/{{course_id}}"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Status 204', () => pm.response.to.have.status(204));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "GET /courses/{id} — After delete (expect 404)",
              "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }],
                "url": "{{base_url}}/courses/{{course_id}}"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Status 404', () => pm.response.to.have.status(404));"
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
